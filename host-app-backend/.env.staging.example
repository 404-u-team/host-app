# Copy to .env.staging for manual deployment, or use Komodo Stack Environment.
POSTGRES_DB=hostapp
POSTGRES_USER=hostapp
# Required: set a long random password before deployment.
POSTGRES_PASSWORD=

# Without SMTP, registration works without email verification.
EMAIL_VERIFICATION_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_SSL_ENABLED=false
SMTP_TLS_ENABLED=true
