# Copy to .env.staging for manual deployment, or use Komodo Stack Environment.
POSTGRES_DB=hostapp
POSTGRES_USER=hostapp
# Required: set a long random password before deployment.
POSTGRES_PASSWORD=

# SMTP over SSL for staging. Replace sample values and set SMTP_PASSWORD.
EMAIL_VERIFICATION_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true

SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USERNAME=hostapp@example.com
SMTP_PASSWORD=
SMTP_FROM=hostapp@example.com
SMTP_AUTH=true
SMTP_SSL_ENABLED=true
SMTP_TLS_ENABLED=false
