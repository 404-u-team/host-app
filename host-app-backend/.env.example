# Docker Compose reads .env automatically. For Maven, export these variables first.
POSTGRES_DB=hostapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=54500
BACKEND_PORT=8080

# Optional: creates ADMIN once without email verification (12-255 characters).
# Does not change an existing administrator's password.
ADMIN_BOOTSTRAP_PASSWORD=

# false + no SMTP: regex only. Configured SMTP enables verification automatically.
# true requires valid SMTP settings, otherwise backend startup fails.
EMAIL_VERIFICATION_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
# STARTTLS (587): SSL=false, TLS=true. Implicit SSL (465): SSL=true, TLS=false.
SMTP_SSL_ENABLED=false
SMTP_TLS_ENABLED=true
