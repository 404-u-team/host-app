<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.hostapp.desktop.controller.ServersController"
      fx:id="root" spacing="10" styleClass="page">
    <Label text="Серверы" styleClass="title"/>
    <FlowPane hgap="8" vgap="8">
        <Button fx:id="detailsButton" text="Подробнее" onAction="#details"/>
        <Button fx:id="editButton" text="Изменить" onAction="#edit"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#delete"/>
        <Button text="Обновить" onAction="#refresh"/>
    </FlowPane>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="hostnameColumn" text="Имя сервера" prefWidth="220"/>
            <TableColumn fx:id="osColumn" text="ОС" prefWidth="140"/>
            <TableColumn fx:id="cpuColumn" text="CPU" prefWidth="65"/>
            <TableColumn fx:id="ramColumn" text="RAM, ГБ" prefWidth="90"/>
            <TableColumn fx:id="diskColumn" text="Диск, ГБ" prefWidth="90"/>
            <TableColumn fx:id="ipv4Column" text="IPv4" prefWidth="150"/>
            <TableColumn fx:id="dateColumn" text="Создан" prefWidth="170"/>
        </columns>
    </TableView>
    <Label fx:id="countLabel" text="Серверов: 0"/>
</VBox>
