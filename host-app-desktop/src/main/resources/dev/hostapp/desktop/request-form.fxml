<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.hostapp.desktop.controller.RequestFormController"
      fx:id="root" spacing="14" prefWidth="500" styleClass="page">
    <Label text="Параметры заявки" styleClass="title"/>
    <GridPane hgap="14" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="CPU, ядра" GridPane.rowIndex="0"/>
        <TextField fx:id="cpuField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="RAM, ГБ" GridPane.rowIndex="1"/>
        <TextField fx:id="ramField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Диск, ГБ" GridPane.rowIndex="2"/>
        <TextField fx:id="diskField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="ОС" GridPane.rowIndex="3"/>
        <TextField fx:id="osField" promptText="Например, Ubuntu 24.04" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>
    <Label text="CPU, RAM и диск должны быть целыми положительными числами." wrapText="true" styleClass="hint"/>
    <HBox alignment="CENTER_RIGHT" spacing="8">
        <Button text="Отмена" onAction="#cancel" cancelButton="true"/>
        <Button text="Сохранить" onAction="#save" defaultButton="true" styleClass="primary"/>
    </HBox>
</VBox>
